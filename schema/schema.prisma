datasource db {
  provider = "postgresql"
  url      = "postgres://postgres:postgres@localhost:5432/shop?sslmode=disable"
}

model Product {
  id          String @id @db.Uuid
  name        String
  description String
  created_at  DateTime
  price       Decimal
  @@map("product")
}

model User {
  id          String @id @db.Uuid
  username    String
  hash_pass    String
}
